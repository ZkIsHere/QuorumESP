menu "QuorumESP"

    menu "Network"

        menu "Wi-Fi"

            config QUORUMESP_WIFI_SSID
                string "Wi-Fi SSID (menuconfig only — local sdkconfig, never committed)"
                default ""

            config QUORUMESP_WIFI_PASSWORD
                string "Wi-Fi password (menuconfig only — local sdkconfig, never committed)"
                default ""

        endmenu

        comment "Ethernet is not supported yet — Wi-Fi only for now"

        config QUORUMESP_SERVER_PORT
            int "qnetd-side TCP listen port"
            default 5403

    endmenu

    config QUORUMESP_REQUIRE_CLIENT_CERT
        bool "Require + verify client certificate (mutual TLS)"
        default n

    menuconfig QUORUMESP_WEB_ENABLE
        bool "Enable web management UI (see docs/web.md)"
        default n

    if QUORUMESP_WEB_ENABLE

        config QUORUMESP_WEB_PORT
            int "Web UI listen port"
            default 80

        config QUORUMESP_WEB_USER
            string "Web UI username (empty = UI refuses to start)"
            default ""

        config QUORUMESP_WEB_PASSWORD
            string "Web UI password (menuconfig only — local sdkconfig, never committed)"
            default ""

        config QUORUMESP_WEB_LOGIN_MAX_FAIL
            int "Failed logins before an IP goes silent"
            default 5

        config QUORUMESP_WEB_LOGIN_BLOCK_S
            int "Silent-drop seconds after login rate limit"
            default 60

    endif

    config QUORUMESP_DEBUG
        bool "Debug mode (verbose logs + extra diagnostics on web UI)"
        default n

endmenu
