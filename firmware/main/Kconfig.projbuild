menu "QuorumESP"

    menu "Network"

        menu "Wi-Fi"

            config QUORUMESP_WIFI_SSID
                string "Wi-Fi SSID (menuconfig only — local sdkconfig, never committed)"
                default ""

            config QUORUMESP_WIFI_PASSWORD
                string "Wi-Fi password (menuconfig only — local sdkconfig, never committed)"
                default ""

        endmenu

        comment "Ethernet is not supported yet — Wi-Fi only for now"

        config QUORUMESP_SERVER_PORT
            int "qnetd-side TCP listen port"
            default 5403

        config QUORUMESP_MAX_SESSIONS
            int "Absolute ceiling for concurrent sessions (runtime heap gate decides)"
            range 1 8
            default 5

        config QUORUMESP_MIN_HEAP_ACCEPT
            int "Free-heap floor (bytes) to admit a new session; below = refuse"
            default 40960

    endmenu

    menu "TLS certificates"

        comment "Server identity + the CA used to verify clients (mutual TLS)"
        comment "Each value is base64 of the DER bytes (single line, no PEM headers):"
        comment "  openssl x509 -in cert.crt -outform der | base64 -w0"
        comment "  openssl rsa -in key.key -outform der | base64 -w0   (or -outform der PKCS8)"
        comment "Empty = fall back to firmware/certs_dev/* at build time (dev only)"
        comment "Values live in local sdkconfig (git-ignored), never committed"

        config QUORUMESP_TLS_SERVER_CRT_B64
            string "Server certificate (base64 DER, presented to clients)"
            default ""

        config QUORUMESP_TLS_SERVER_KEY_B64
            string "Server private key (base64 DER)"
            default ""

        config QUORUMESP_TLS_CLIENT_CA_B64
            string "Client CA certificate (base64 DER, verifies clients in mutual mode)"
            default ""

        config QUORUMESP_REQUIRE_CLIENT_CERT
            bool "Require + verify client certificate (mutual TLS)"
            default n

    endmenu

    menu "Web UI"

        menuconfig QUORUMESP_WEB_ENABLE
            bool "Enable web management UI (see docs/web.md)"
            default n

        if QUORUMESP_WEB_ENABLE

            config QUORUMESP_WEB_PORT
                int "Listen port"
                default 80

            config QUORUMESP_WEB_USER
                string "Username (empty = UI refuses to start)"
                default ""

            config QUORUMESP_WEB_PASSWORD
                string "Password (menuconfig only — local sdkconfig, never committed)"
                default ""

            config QUORUMESP_WEB_LOGIN_MAX_FAIL
                int "Failed logins before an IP goes silent"
                default 5

            config QUORUMESP_WEB_LOGIN_BLOCK_S
                int "Silent-drop seconds after login rate limit"
                default 60

        endif

    endmenu

    config QUORUMESP_DEBUG
        bool "Debug mode (verbose logs + extra diagnostics on web UI)"
        default n

endmenu
