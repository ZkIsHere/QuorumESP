# Release build fragment (CI only, never used for local dev).
# Applied on top of sdkconfig.defaults via
#   -DSDKCONFIG_DEFAULTS="sdkconfig.defaults;sdkconfig.release"
# so local menuconfig/sdkconfig setups are untouched.
#
# Artifacts (firmware.bin + version.txt) are consumed by the static portal
# (host/portal-static/) over USB — there is no on-device auto-updater
# (see docs/ota.md).

# Server-auth TLS only if certs embedded (CI embeds none),
# no client-cert requirement. Mutual auth returns with production certs.
CONFIG_QUORUMESP_REQUIRE_CLIENT_CERT=n
